#!/bin/bash
# Daily restic backup of /home/ben to the NAS.
# Runs via systemd: restic-backup.timer -> restic-backup.service
set -euo pipefail   # stop at the first error, so failures reach systemd

source ~/.config/restic/environment.sh

# Clear locks left behind by interrupted runs (safe: only removes stale ones)
restic unlock

restic backup \
    --verbose \
    --one-file-system \
    --exclude-caches \
    --files-from ~/.config/restic/backup.files \
    --exclude-file ~/.config/restic/exclude.files

notify-send "Restic backup finished."
